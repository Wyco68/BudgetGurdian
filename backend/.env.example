# --- Supabase PostgreSQL -----------------------------------------------------
# Find both URLs in the Supabase dashboard: Project Settings -> Database.
#
# DATABASE_URL  - pooled connection (PgBouncer, port 6543) used by the app.
# DIRECT_URL    - direct connection (port 5432) used only by prisma migrate.
#
# NEVER commit the real values. The desktop app never sees these.
#
# Connect as a dedicated least-privilege role, NOT as `postgres`. The built-in
# superuser has BYPASSRLS, so using it would silently defeat the row-level
# security policies in prisma/migrations (see docs/DEPLOYMENT.md for the
# CREATE ROLE statements).
DATABASE_URL="postgresql://budget_backend.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://budget_backend.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Server ------------------------------------------------------------------
PORT=8080

# Interface to bind. Defaults to 127.0.0.1 (desktop app only, same machine).
# Set 0.0.0.0 to expose on the network — only ever together with API_KEY.
HOST=127.0.0.1

# Shared secret. When set, every request must carry the header
# "X-API-Key: <value>". Leave empty to disable during local development;
# the server refuses to boot without it when NODE_ENV=production.
API_KEY=
