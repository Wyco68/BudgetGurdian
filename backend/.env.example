# --- Neon PostgreSQL ---------------------------------------------------------
# Find the endpoint host in the Neon console: Project -> Connect.
#
# DATABASE_URL  - runtime queries. Connects as the least-privilege
#                 `budget_backend` role, so the RLS policies actually apply.
# DIRECT_URL    - `prisma migrate` only. Connects as the database owner
#                 (`neondb_owner`), which is the role allowed to run DDL.
#
# NEVER commit the real values. The desktop app never sees these.
#
# Two roles on purpose: in PostgreSQL a table's owner bypasses RLS unless the
# table is set to FORCE ROW LEVEL SECURITY. Migrating as the owner and then
# serving traffic as a *non-owner* role is what keeps the `backend_all`
# policies in prisma/migrations meaningful. Running the app as `neondb_owner`
# would silently defeat them. See docs/DEPLOYMENT.md for the CREATE ROLE and
# GRANT statements.
#
# Use the direct (non-pooled) endpoint. This backend is a single process with
# one Prisma pool, so Neon's `-pooler` endpoint adds nothing and only adds a
# failure mode. `connect_timeout` covers Neon's scale-to-zero cold start —
# without the margin the first request after an idle period can fail outright.
# Do NOT carry over `?pgbouncer=true&connection_limit=1`: those are Supabase
# PgBouncer knobs, and connection_limit=1 starves the pool here.
DATABASE_URL="postgresql://budget_backend:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Server ------------------------------------------------------------------
PORT=8080

# Interface to bind. Defaults to 127.0.0.1 (desktop app only, same machine).
# Set 0.0.0.0 to expose on the network — only ever together with API_KEY.
HOST=127.0.0.1

# Shared secret. When set, every request must carry the header
# "X-API-Key: <value>". Leave empty to disable during local development;
# the server refuses to boot without it when NODE_ENV=production.
API_KEY=
